//@version=6
// Daily One-Trade Ensemble - TradingView version of the tradebot strategy.
// Add it to a DAILY chart (any symbol, e.g. SPY). Once per day, at the close, it scores the
// watchlist with the trend / momentum / relative-strength / pullback strategies and picks ONE
// trade for the next session: buy at the next open, sell at the following open.
// Alerts: create an alert with condition "Daily One-Trade Ensemble" -> "Any alert() function call".
// The alert text is JSON in TradersPost format, so it can be sent to a relay by webhook (paid
// TradingView plan) - or just read on your phone and placed by hand.
indicator("Daily One-Trade Ensemble", overlay = true, max_labels_count = 500)

// ---------------- inputs
grpW = "Watchlist (24 symbols)"
s01 = input.symbol("SPY", "1", group = grpW)
s02 = input.symbol("QQQ", "2", group = grpW)
s03 = input.symbol("IWM", "3", group = grpW)
s04 = input.symbol("DIA", "4", group = grpW)
s05 = input.symbol("XLK", "5", group = grpW)
s06 = input.symbol("XLF", "6", group = grpW)
s07 = input.symbol("XLE", "7", group = grpW)
s08 = input.symbol("XLV", "8", group = grpW)
s09 = input.symbol("XLY", "9", group = grpW)
s10 = input.symbol("XLI", "10", group = grpW)
s11 = input.symbol("XLP", "11", group = grpW)
s12 = input.symbol("XLU", "12", group = grpW)
s13 = input.symbol("XLC", "13", group = grpW)
s14 = input.symbol("GLD", "14", group = grpW)
s15 = input.symbol("TLT", "15", group = grpW)
s16 = input.symbol("AAPL", "16", group = grpW)
s17 = input.symbol("MSFT", "17", group = grpW)
s18 = input.symbol("NVDA", "18", group = grpW)
s19 = input.symbol("AMZN", "19", group = grpW)
s20 = input.symbol("GOOGL", "20", group = grpW)
s21 = input.symbol("META", "21", group = grpW)
s22 = input.symbol("TSLA", "22", group = grpW)
s23 = input.symbol("AVGO", "23", group = grpW)
s24 = input.symbol("JPM", "24", group = grpW)
bench = input.symbol("SPY", "Market regime symbol", group = grpW)

grpS = "Strategy weights"
wTrend = input.float(1.0, "Trend (50/200-day)", minval = 0, step = 0.25, group = grpS)
wTs    = input.float(1.0, "Time-series momentum (12-1 month)", minval = 0, step = 0.25, group = grpS)
wXs    = input.float(1.0, "Relative strength (6 month)", minval = 0, step = 0.25, group = grpS)
wMr    = input.float(0.5, "Pullback in uptrend (RSI 2)", minval = 0, step = 0.25, group = grpS)
minScore = input.float(0.15, "Minimum score to trade", step = 0.05, group = grpS)
useRegime = input.bool(true, "Need 2x score when market is below its 200-day average", group = grpS)

grpR = "Risk & orders"
equity  = input.float(10000, "Account size ($)", minval = 100, group = grpR)
riskPct = input.float(2.0, "Risk per trade (% of account)", minval = 0.1, step = 0.1, group = grpR)
maxPos  = input.float(100, "Max position (% of account)", minval = 1, group = grpR)
stopAtr = input.float(2.0, "Stop-loss distance (x ATR 14)", minval = 0.25, step = 0.25, group = grpR)
showTable = input.bool(true, "Show ranking table", group = grpR)

// ---------------- per-symbol calculations (run on daily data of each symbol)
f_tanh(x) =>
    xc = math.max(math.min(x, 20.0), -20.0)
    e2 = math.exp(2.0 * xc)
    (e2 - 1.0) / (e2 + 1.0)

f_calc() =>
    c = close
    s50 = ta.sma(c, 50)
    s200 = ta.sma(c, 200)
    trendS = 0.5 * math.sign(c - s200) + 0.5 * f_tanh((s50 / s200 - 1.0) * 20.0)
    r121 = c[21] / c[252] - 1.0
    vol = ta.stdev(c / c[1] - 1.0, 60) * math.sqrt(252)
    tsS = f_tanh(r121 / vol)
    raw = (50.0 - ta.rsi(c, 2)) / 50.0
    stretch = f_tanh((ta.sma(c, 5) / c - 1.0) * 40.0)
    mr0 = 0.7 * raw + 0.3 * stretch
    mrS = c > s200 ? mr0 : math.min(mr0, 0.0) + 0.25 * math.max(mr0, 0.0)
    r126 = c / c[126] - 1.0
    [trendS, tsS, mrS, r126, c, ta.atr(14)]

[t01, m01, p01, x01, c01, a01] = request.security(s01, "D", f_calc())
[t02, m02, p02, x02, c02, a02] = request.security(s02, "D", f_calc())
[t03, m03, p03, x03, c03, a03] = request.security(s03, "D", f_calc())
[t04, m04, p04, x04, c04, a04] = request.security(s04, "D", f_calc())
[t05, m05, p05, x05, c05, a05] = request.security(s05, "D", f_calc())
[t06, m06, p06, x06, c06, a06] = request.security(s06, "D", f_calc())
[t07, m07, p07, x07, c07, a07] = request.security(s07, "D", f_calc())
[t08, m08, p08, x08, c08, a08] = request.security(s08, "D", f_calc())
[t09, m09, p09, x09, c09, a09] = request.security(s09, "D", f_calc())
[t10, m10, p10, x10, c10, a10] = request.security(s10, "D", f_calc())
[t11, m11, p11, x11, c11, a11] = request.security(s11, "D", f_calc())
[t12, m12, p12, x12, c12, a12] = request.security(s12, "D", f_calc())
[t13, m13, p13, x13, c13, a13] = request.security(s13, "D", f_calc())
[t14, m14, p14, x14, c14, a14] = request.security(s14, "D", f_calc())
[t15, m15, p15, x15, c15, a15] = request.security(s15, "D", f_calc())
[t16, m16, p16, x16, c16, a16] = request.security(s16, "D", f_calc())
[t17, m17, p17, x17, c17, a17] = request.security(s17, "D", f_calc())
[t18, m18, p18, x18, c18, a18] = request.security(s18, "D", f_calc())
[t19, m19, p19, x19, c19, a19] = request.security(s19, "D", f_calc())
[t20, m20, p20, x20, c20, a20] = request.security(s20, "D", f_calc())
[t21, m21, p21, x21, c21, a21] = request.security(s21, "D", f_calc())
[t22, m22, p22, x22, c22, a22] = request.security(s22, "D", f_calc())
[t23, m23, p23, x23, c23, a23] = request.security(s23, "D", f_calc())
[t24, m24, p24, x24, c24, a24] = request.security(s24, "D", f_calc())
[bClose, bSma] = request.security(bench, "D", [close, ta.sma(close, 200)])

syms   = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24)
trendA = array.from(t01, t02, t03, t04, t05, t06, t07, t08, t09, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24)
tsA    = array.from(m01, m02, m03, m04, m05, m06, m07, m08, m09, m10, m11, m12, m13, m14, m15, m16, m17, m18, m19, m20, m21, m22, m23, m24)
mrA    = array.from(p01, p02, p03, p04, p05, p06, p07, p08, p09, p10, p11, p12, p13, p14, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24)
retA   = array.from(x01, x02, x03, x04, x05, x06, x07, x08, x09, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24)
closeA = array.from(c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24)
atrA   = array.from(a01, a02, a03, a04, a05, a06, a07, a08, a09, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24)

// ---------------- combine: relative-strength rank across the list, then weighted score
N = array.size(syms)
wSum = wTrend + wTs + wXs + wMr
scores = array.new_float(N, na)
nValid = 0
for i = 0 to N - 1
    if not na(array.get(retA, i))
        nValid += 1
for i = 0 to N - 1
    ri = array.get(retA, i)
    if not na(ri) and nValid > 1 and wSum > 0
        below = 0
        for j = 0 to N - 1
            rj = array.get(retA, j)
            if not na(rj) and rj < ri
                below += 1
        xs = float(below) / (nValid - 1) * 2.0 - 1.0
        s = (wTrend * array.get(trendA, i) + wTs * array.get(tsA, i) + wXs * xs + wMr * array.get(mrA, i)) / wSum
        array.set(scores, i, s)

bestI = -1
bestS = -10.0
for i = 0 to N - 1
    s = array.get(scores, i)
    if not na(s) and s > bestS
        bestS := s
        bestI := i

bull = bClose > bSma
thr = minScore * (useRegime and not bull ? 2.0 : 1.0)
hasTrade = bestI >= 0 and bestS >= thr

f_ticker(sym) =>
    parts = str.split(sym, ":")
    array.get(parts, array.size(parts) - 1)

pickSym = hasTrade ? f_ticker(array.get(syms, bestI)) : ""
pickClose = hasTrade ? array.get(closeA, bestI) : na
pickAtr = hasTrade ? array.get(atrA, bestI) : na
qty = hasTrade ? math.floor(math.min(equity * riskPct / 100.0 / (stopAtr * pickAtr), equity * maxPos / 100.0 / pickClose)) : 0
stopPx = hasTrade ? math.round(pickClose - stopAtr * pickAtr, 2) : na

// ---------------- alerts at the daily close (one rotation per day)
var string held = ""
if barstate.isconfirmed and timeframe.isdaily
    newPick = hasTrade and qty > 0 ? pickSym : ""
    if held != "" and held != newPick
        alert('{"ticker":"' + held + '","action":"exit"}', alert.freq_once_per_bar_close)
    if newPick != ""
        if newPick == held
            alert('{"ticker":"' + newPick + '","action":"hold","note":"still the top pick - keep the position, move the stop to ' + str.tostring(stopPx) + '"}', alert.freq_once_per_bar_close)
        else
            alert('{"ticker":"' + newPick + '","action":"buy","quantity":' + str.tostring(qty) + ',"orderType":"market","signalPrice":' + str.tostring(math.round(pickClose, 2)) + ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(stopPx) + '}}', alert.freq_once_per_bar_close)
    held := newPick

// ---------------- on-chart display
plotchar(hasTrade, "Trade day", "•", location.bottom, color.new(#2a78d6, 0), size = size.tiny)

var table tb = table.new(position.top_right, 3, 13, bgcolor = color.new(#fcfcfb, 0), border_color = color.new(#e1e0d9, 0), border_width = 1)
if showTable and barstate.islast
    table.clear(tb, 0, 0, 2, 12)
    head = hasTrade ? "TODAY: BUY " + str.tostring(qty) + " " + pickSym + "  stop " + str.tostring(stopPx) : "TODAY: no trade (best " + str.tostring(bestS, "#.##") + " < " + str.tostring(thr, "#.##") + ")"
    table.cell(tb, 0, 0, head, text_color = color.new(#0b0b0b, 0), text_size = size.small)
    table.merge_cells(tb, 0, 0, 2, 0)
    table.cell(tb, 0, 1, "Rank", text_color = color.new(#52514e, 0), text_size = size.small)
    table.cell(tb, 1, 1, "Symbol", text_color = color.new(#52514e, 0), text_size = size.small)
    table.cell(tb, 2, 1, "Score", text_color = color.new(#52514e, 0), text_size = size.small)
    used = array.new_bool(N, false)
    for r = 0 to 9
        bi = -1
        bs = -10.0
        for i = 0 to N - 1
            s = array.get(scores, i)
            if not array.get(used, i) and not na(s) and s > bs
                bs := s
                bi := i
        if bi >= 0
            array.set(used, bi, true)
            table.cell(tb, 0, r + 2, str.tostring(r + 1), text_size = size.small)
            table.cell(tb, 1, r + 2, f_ticker(array.get(syms, bi)), text_size = size.small)
            table.cell(tb, 2, r + 2, str.tostring(bs, "#.###"), text_color = bs >= 0 ? color.new(#006300, 0) : color.new(#b42828, 0), text_size = size.small)
    table.cell(tb, 0, 12, "Market: " + (bull ? "above" : "below") + " 200-day avg", text_color = color.new(#52514e, 0), text_size = size.small)
    table.merge_cells(tb, 0, 12, 2, 12)
